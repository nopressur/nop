{
  "name": "nop-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:legacy && npm run check:bundle",
    "build:legacy": "babel ../../builtin/site.js --out-file ../../builtin/site.js --config-file ./babel.legacy.config.cjs --compact true && terser ../../builtin/site.js --compress ecma=2019 --mangle --format ecma=2019,comments=false -o ../../builtin/site.js",
    "preview": "vite preview",
    "check": "npm run check:types && npm run lint:compat && npm run build",
    "check:bundle": "node scripts/check-site-bundle.mjs",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "lint:compat": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "browserslist": [
    "iOS >= 12",
    "Safari >= 12"
  ],
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/node": "^25.0.3",
    "@typescript-eslint/parser": "^8.61.1",
    "es-check": "^9.6.4",
    "eslint": "^10.5.0",
    "eslint-plugin-compat": "^7.0.2",
    "jsdom": "^29.1.1",
    "terser": "^5.48.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.16"
  },
  "dependencies": {}
}
