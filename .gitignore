.DS_Store
.vscode/
.idea/
*.swp

# Generated by Cargo
# will have compiled files and executables
debug/
target/
# Shared-target symlink (fresh worktrees); target/ alone does not match symlinks.
/nop/target
/nop/builtin/
vendor/

# Per-crate Cargo locks are build side-effects; only nop/Cargo.lock is tracked.
nop/crates/*/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

config.yaml
users.yaml
runtime/
**/__pycache__/

node_modules/
nop/ts/login/argon2-asm/build/
tests/playwright/.cache/
tests/playwright/test-results/
tests/playwright/report/
