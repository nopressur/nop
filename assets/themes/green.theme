# Theme palette for green

color-background-primary-light #f0fdf4
color-background-secondary-light #86efac
color-content-background-light #ffffff
color-text-primary-light #14532d
color-text-secondary-light #166534
color-navbar-background-light rgba(255, 255, 255, 0.95)
color-footer-background-light rgba(255, 255, 255, 0.95)
color-border-light rgba(34, 197, 94, 0.2)
color-shadow-light rgba(34, 197, 94, 0.1)
color-code-background-light #dcfce7
color-blockquote-background-light #dcfce7
color-table-border-light #4ade80
color-table-header-background-light #dcfce7
color-background-primary-dark #052e16
color-background-secondary-dark #14532d
color-content-background-dark #14532d
color-text-primary-dark #bbf7d0
color-text-secondary-dark #4ade80
color-navbar-background-dark rgba(20, 83, 45, 0.95)
color-footer-background-dark rgba(20, 83, 45, 0.95)
color-border-dark rgba(74, 222, 128, 0.3)
color-shadow-dark rgba(0, 0, 0, 0.4)
color-code-background-dark #166534
color-blockquote-background-dark #166534
color-table-border-dark #22c55e
color-table-header-background-dark #166534
color-content-link-light #22c55e
color-content-link-dark #4ade80
color-breadcrumb-link-dark #4ade80
color-content-blockquote-border-light #22c55e
color-navbar-dropdown-arrow-light #16a34a
color-navbar-dropdown-border-top-light rgba(34, 197, 94, 0.2)
color-navbar-dropdown-item-hover-background-light #dcfce7
color-navbar-dropdown-background-dark #052e16
color-navbar-dropdown-border-dark rgba(74, 222, 128, 0.3)
color-navbar-dropdown-shadow-dark rgba(0, 0, 0, 0.4)
color-navbar-dropdown-item-hover-background-dark #166534
color-navbar-link-hover-background-dark #166534
color-navbar-dropdown-link-hover-background-dark #166534
color-notification-warning-background-dark #22c55e
color-notification-warning-text-dark #f0fdf4

# Typography
font-body-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-heading-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-mono-family monospace
font-body-size 16px
font-body-line-height normal
font-body-weight 400
font-heading-weight 700
font-heading-line-height 1.2
font-nav-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-nav-weight 400
font-control-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-code-size 0.875em
font-code-line-height normal

# Layout and components
size-content-padding 2rem
size-content-margin-y 1rem
size-navbar-min-height 3.25rem
size-search-panel-radius 12px
size-control-radius 8px
size-code-radius 5px
size-table-cell-padding 0.75rem
size-blockquote-padding 1rem

# Visual treatment
shadow-content-media none
border-width-control 1px
border-width-table 1px
opacity-search-backdrop-light 0.65
opacity-search-backdrop-dark 0.75
