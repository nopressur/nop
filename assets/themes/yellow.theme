# Theme palette for yellow

color-background-primary-light #fffbeb
color-background-secondary-light #fde68a
color-content-background-light #ffffff
color-text-primary-light #78350f
color-text-secondary-light #92400e
color-navbar-background-light rgba(255, 255, 255, 0.95)
color-footer-background-light rgba(255, 255, 255, 0.95)
color-border-light rgba(217, 119, 6, 0.2)
color-shadow-light rgba(217, 119, 6, 0.1)
color-code-background-light #fef3c7
color-blockquote-background-light #fef3c7
color-table-border-light #fcd34d
color-table-header-background-light #fef3c7
color-background-primary-dark #451a03
color-background-secondary-dark #78350f
color-content-background-dark #78350f
color-text-primary-dark #fde68a
color-text-secondary-dark #fbbf24
color-navbar-background-dark rgba(120, 53, 15, 0.95)
color-footer-background-dark rgba(120, 53, 15, 0.95)
color-border-dark rgba(251, 191, 36, 0.3)
color-shadow-dark rgba(0, 0, 0, 0.4)
color-code-background-dark #92400e
color-blockquote-background-dark #92400e
color-table-border-dark #d97706
color-table-header-background-dark #92400e
color-content-link-light #d97706
color-content-link-dark #fbbf24
color-breadcrumb-link-dark #fbbf24
color-content-blockquote-border-light #d97706
color-navbar-dropdown-arrow-light #3850b7
color-navbar-dropdown-border-top-light #dbdbdb
color-navbar-dropdown-item-hover-background-light #fef3c7
color-navbar-dropdown-background-dark #451a03
color-navbar-dropdown-border-dark rgba(251, 191, 36, 0.3)
color-navbar-dropdown-shadow-dark rgba(0, 0, 0, 0.4)
color-navbar-dropdown-item-hover-background-dark #92400e
color-navbar-link-hover-background-dark #92400e
color-navbar-dropdown-link-hover-background-dark #92400e
color-notification-warning-background-dark #d97706
color-notification-warning-text-dark #fffbeb

# Typography
font-body-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-heading-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-mono-family monospace
font-body-size 16px
font-body-line-height normal
font-body-weight 400
font-heading-weight 700
font-heading-line-height 1.2
font-nav-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-nav-weight 400
font-control-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-code-size 0.875em
font-code-line-height normal

# Layout and components
size-content-padding 2rem
size-content-margin-y 1rem
size-navbar-min-height 3.25rem
size-search-panel-radius 12px
size-control-radius 8px
size-code-radius 5px
size-table-cell-padding 0.75rem
size-blockquote-padding 1rem

# Visual treatment
shadow-content-media none
border-width-control 1px
border-width-table 1px
opacity-search-backdrop-light 0.65
opacity-search-backdrop-dark 0.75
