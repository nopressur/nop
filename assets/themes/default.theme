# Theme palette for default

color-background-primary-light #f5f7fa
color-background-secondary-light #c3cfe2
color-content-background-light #ffffff
color-text-primary-light #363636
color-text-secondary-light #4a4a4a
color-navbar-background-light rgba(255, 255, 255, 0.95)
color-footer-background-light rgba(255, 255, 255, 0.95)
color-border-light rgba(0, 0, 0, 0.1)
color-shadow-light rgba(0, 0, 0, 0.1)
color-code-background-light #f5f5f5
color-blockquote-background-light #f5f5f5
color-table-border-light #dbdbdb
color-table-header-background-light #f5f5f5
color-background-primary-dark #1a1a1a
color-background-secondary-dark #2d3748
color-content-background-dark #2d3748
color-text-primary-dark #f7fafc
color-text-secondary-dark #e2e8f0
color-navbar-background-dark rgba(45, 55, 72, 0.95)
color-footer-background-dark rgba(45, 55, 72, 0.95)
color-border-dark rgba(255, 255, 255, 0.1)
color-shadow-dark rgba(0, 0, 0, 0.3)
color-code-background-dark #4a5568
color-blockquote-background-dark #4a5568
color-table-border-dark #4a5568
color-table-header-background-dark #4a5568
color-content-link-light #3273dc
color-content-link-dark #63b3ed
color-breadcrumb-link-dark #63b3ed
color-content-blockquote-border-light #3273dc
color-navbar-dropdown-arrow-light #3850b7
color-navbar-dropdown-border-top-light #dbdbdb
color-navbar-dropdown-item-hover-background-light #f5f5f5
color-navbar-dropdown-background-dark rgba(26, 26, 26, 0.95)
color-navbar-dropdown-border-dark 0.1)
color-navbar-dropdown-shadow-dark 0.4)
color-navbar-dropdown-item-hover-background-dark rgba(255, 255, 255, 0.1)
color-navbar-link-hover-background-dark rgba(255, 255, 255, 0.1)
color-navbar-dropdown-link-hover-background-dark rgba(255, 255, 255, 0.1)
color-notification-warning-background-dark #d69e2e
color-notification-warning-text-dark #1a202c

# Typography
font-body-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-heading-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-mono-family monospace
font-body-size 16px
font-body-line-height normal
font-body-weight 400
font-heading-weight 700
font-heading-line-height 1.2
font-nav-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-nav-weight 400
font-control-family 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
font-code-size 0.875em
font-code-line-height normal

# Layout and components
size-content-padding 2rem
size-content-margin-y 1rem
size-navbar-min-height 3.25rem
size-search-panel-radius 12px
size-control-radius 8px
size-code-radius 5px
size-table-cell-padding 0.75rem
size-blockquote-padding 1rem

# Visual treatment
shadow-content-media none
border-width-control 1px
border-width-table 1px
opacity-search-backdrop-light 0.65
opacity-search-backdrop-dark 0.75
